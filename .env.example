# API Proxy Configuration
PROXY_URL=http://localhost:8000
PROXY_API_KEY=your-api-key-here

# Local LLM Configuration (MLX-based server)
LLM_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL=qwen/qwen3-14b

# Calendar Agent Server
CALENDAR_AGENT_PORT=8082

# Mutation timeouts (see README "Coupling with api-proxy"). Leave unset to
# use the defaults; PROXY_CONFIRMATION_WINDOW must mirror the proxy's
# --confirmation-timeout by hand.
# PROXY_CONFIRMATION_WINDOW=300
# PROXY_CONFIRM_TIMEOUT=330
